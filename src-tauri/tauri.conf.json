{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Task Rail",
  "version": "0.6.0",
  "identifier": "com.markcastle.taskrail",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run ui:dev",
    "beforeBuildCommand": "npm run ui:build"
  },
  "app": {
    "windows": [
      {
        "label": "rail",
        "title": "Task Rail",
        "width": 320,
        "height": 800,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0OTI5NEFFRDRCODA4MDUKUldRRkNMalVycFNTRkduQ3hGenU4STV3dTFFZTBSZUFEeC96R21rQ2xMYjR2Y0pWc3ZpWE5WVlEK",
      "endpoints": ["https://github.com/markcastle/taskrail/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Mark Castle",
    "shortDescription": "A task strip that lives on the edge of your screen.",
    "license": "MIT",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
