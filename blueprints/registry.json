{
  "version": 1,
  "blueprints": [
    {
      "id": "demo-tracker",
      "title": "Demo tracker",
      "description": "The small fake issue tracker that ships inside Task Rail. Here as the worked example of a blueprint: a profile with {me} and an identity, so it works for whoever signs in.",
      "homepage": "https://github.com/markcastle/taskrail",
      "match": {
        "tools": [
          "list_tickets",
          "transition_ticket",
          "whoami"
        ]
      },
      "profile": {
        "kind": "task",
        "list": {
          "tool": "list_tickets",
          "arguments": {
            "open_only": false
          },
          "items": "$.tickets[*]",
          "fields": {
            "external_id": "$.ticket_id",
            "title": "$.summary",
            "status": "$.state",
            "priority": "$.priority",
            "due": "$.due_date",
            "url": "$.link"
          },
          "where": [
            {
              "path": "$.assignee",
              "equals": "{me}"
            }
          ]
        },
        "identity": {
          "tool": "whoami",
          "arguments": {},
          "id": "$.id"
        },
        "set_status": {
          "tool": "transition_ticket",
          "arguments": {
            "ticket_id": "{external_id}",
            "state": "{status}"
          }
        },
        "create": {
          "tool": "create_ticket",
          "arguments": {
            "summary": "{title}"
          }
        },
        "status_map": {
          "to_section": {
            "Backlog": "todo",
            "Selected": "todo",
            "In Progress": "in_progress",
            "Done": "done"
          },
          "canonical": {
            "todo": "Selected",
            "in_progress": "In Progress",
            "done": "Done"
          }
        },
        "priority_map": {
          "P1": "highest",
          "P2": "high",
          "P3": "normal",
          "P4": "low"
        },
        "poll_seconds": 60
      }
    },
    {
      "id": "tuesday",
      "title": "Tuesday",
      "description": "Inovus Medical's Tuesday platform. Tasks assigned to you on every board you can see; moving one on the rail updates its status.",
      "match": {
        "tools": [
          "get_board",
          "list_boards",
          "whoami",
          "update_task"
        ],
        "url_contains": [
          "tuesday.inovusmedical.com"
        ]
      },
      "profile": {
        "identity": {
          "arguments": {},
          "id": "$.email",
          "tool": "whoami"
        },
        "kind": "task",
        "list": {
          "arguments": {
            "board_id": "{board_id}"
          },
          "fields": {
            "due": "$.due_date",
            "external_id": "$.id",
            "priority": "$.priority",
            "status": "$.status",
            "title": "$.name",
            "updated_at": "$.updated_at"
          },
          "for_each": {
            "arguments": {},
            "id": "$.id",
            "items": "$[*].boards[*]",
            "placeholder": "{board_id}",
            "tool": "list_boards"
          },
          "items": "$.tasks[*]",
          "tool": "get_board",
          "where": [
            {
              "equals": "{me}",
              "path": "$.assignees[*]"
            }
          ]
        },
        "poll_seconds": 60,
        "priority_map": {
          "critical": "highest",
          "high": "high",
          "low": "low",
          "medium": "normal"
        },
        "set_status": {
          "arguments": {
            "status": "{status}",
            "task_id": "{external_id}"
          },
          "tool": "update_task"
        },
        "status_map": {
          "canonical": {
            "done": "done",
            "in_progress": "working_on_it",
            "todo": "not_started"
          },
          "to_section": {
            "blocked": "todo",
            "done": "done",
            "not_started": "todo",
            "stuck": "in_progress",
            "working_on_it": "in_progress"
          }
        }
      },
      "homepage": "https://tuesday.inovusmedical.com"
    }
  ]
}
