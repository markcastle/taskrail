{
  "version": 1,
  "blueprints": [
    {
      "id": "demo-tracker",
      "title": "Demo tracker",
      "description": "The small fake issue tracker that ships inside Task Rail. Here as the worked example of a blueprint: {me} with an identity, a trail of board, group and parent, and choices for only-mine, boards and groups.",
      "homepage": "https://github.com/markcastle/taskrail",
      "match": {
        "tools": [
          "get_board",
          "list_boards",
          "transition_ticket",
          "whoami"
        ]
      },
      "profile": {
        "kind": "task",
        "list": {
          "tool": "get_board",
          "arguments": {
            "board_id": "{board_id}"
          },
          "items": "$.tasks[*]",
          "fields": {
            "external_id": "$.ticket_id",
            "title": "$.summary",
            "status": "$.state",
            "priority": "$.priority",
            "due": "$.due_date",
            "url": "$.link"
          },
          "where": [
            {
              "path": "$.archived_at",
              "not": true
            }
          ],
          "for_each": {
            "tool": "list_boards",
            "arguments": {},
            "items": "$.boards[*]",
            "id": "$.board_id",
            "placeholder": "{board_id}"
          },
          "trail": [
            {
              "name": "board",
              "label": "$.board.name"
            },
            {
              "name": "group",
              "label": "$.name",
              "key": "$.group_id",
              "items": "$.groups[*]",
              "id": "$.id"
            },
            {
              "name": "parent",
              "label": "$.summary",
              "key": "$.parent_id",
              "items": "$.tasks[*]",
              "id": "$.ticket_id"
            }
          ]
        },
        "identity": {
          "tool": "whoami",
          "arguments": {},
          "id": "$.id"
        },
        "set_status": {
          "tool": "transition_ticket",
          "arguments": {
            "ticket_id": "{external_id}",
            "state": "{status}"
          }
        },
        "create": {
          "tool": "create_ticket",
          "arguments": {
            "summary": "{title}"
          }
        },
        "status_map": {
          "to_section": {
            "Backlog": "todo",
            "Selected": "todo",
            "In Progress": "in_progress",
            "Done": "done"
          },
          "canonical": {
            "todo": "Selected",
            "in_progress": "In Progress",
            "done": "Done"
          }
        },
        "priority_map": {
          "P1": "highest",
          "P2": "high",
          "P3": "normal",
          "P4": "low"
        },
        "poll_seconds": 60,
        "choices": [
          {
            "kind": "switch",
            "id": "mine",
            "label": "Only tickets assigned to me",
            "help": "Turn this off to bring in everyone's tickets, not just your own.",
            "default": true,
            "where": [
              {
                "path": "$.assignee",
                "equals": "{me}"
              }
            ]
          },
          {
            "kind": "pick",
            "id": "boards",
            "label": "Boards",
            "help": "Take tickets only from the boards you pick.",
            "containers": "$.name"
          },
          {
            "kind": "pick",
            "id": "groups",
            "label": "Groups",
            "help": "The sections of a board, such as Now and Later. Pick some to leave the rest off the rail.",
            "trail": "group"
          }
        ]
      }
    },
    {
      "id": "tuesday",
      "title": "Tuesday",
      "description": "Inovus Medical's Tuesday platform. Your tasks on the boards you can see, with their board, group and parent task. Scope lets you turn off \"only mine\" for a private board, or keep to one group on one board.",
      "match": {
        "tools": [
          "get_board",
          "list_boards",
          "whoami",
          "update_task"
        ],
        "url_contains": [
          "tuesday.inovusmedical.com"
        ]
      },
      "profile": {
        "identity": {
          "arguments": {},
          "id": "$.email",
          "tool": "whoami"
        },
        "kind": "task",
        "list": {
          "arguments": {
            "board_id": "{board_id}"
          },
          "fields": {
            "due": "$.due_date",
            "external_id": "$.id",
            "priority": "$.priority",
            "status": "$.status",
            "title": "$.name",
            "updated_at": "$.updated_at"
          },
          "for_each": {
            "arguments": {},
            "id": "$.id",
            "items": "$[*].boards[*]",
            "placeholder": "{board_id}",
            "tool": "list_boards"
          },
          "items": "$.tasks[*]",
          "tool": "get_board",
          "where": [
            {
              "path": "$.archived_at",
              "not": true
            }
          ],
          "trail": [
            {
              "name": "board",
              "label": "$.board.name"
            },
            {
              "name": "group",
              "label": "$.name",
              "key": "$.group_id",
              "items": "$.groups[*]",
              "id": "$.id"
            },
            {
              "name": "parent",
              "label": "$.name",
              "key": "$.parent_id",
              "items": "$.tasks[*]",
              "id": "$.id"
            }
          ]
        },
        "poll_seconds": 60,
        "priority_map": {
          "critical": "highest",
          "high": "high",
          "low": "low",
          "medium": "normal"
        },
        "set_status": {
          "arguments": {
            "status": "{status}",
            "task_id": "{external_id}"
          },
          "tool": "update_task"
        },
        "status_map": {
          "canonical": {
            "done": "done",
            "in_progress": "working_on_it",
            "todo": "not_started"
          },
          "to_section": {
            "blocked": "todo",
            "done": "done",
            "not_started": "todo",
            "stuck": "in_progress",
            "working_on_it": "in_progress"
          }
        },
        "choices": [
          {
            "kind": "switch",
            "id": "mine",
            "label": "Only tasks assigned to me",
            "help": "Turn this off to bring in everyone's tasks, for a board you look after or one where nothing is assigned.",
            "default": true,
            "where": [
              {
                "path": "$.assignees[*]",
                "equals": "{me}"
              }
            ]
          },
          {
            "kind": "pick",
            "id": "boards",
            "label": "Boards",
            "help": "Take tasks only from the boards you pick.",
            "containers": "$.name"
          },
          {
            "kind": "pick",
            "id": "groups",
            "label": "Groups",
            "help": "The sections of a board, such as Now, Next and Later. Pick some to leave the rest off the rail.",
            "trail": "group"
          }
        ]
      },
      "homepage": "https://tuesday.inovusmedical.com"
    }
  ]
}
